<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Calculatrice.Pages.MainPage"
             Title="Calculatrice"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#000000">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Styles pour les touches de chiffres et point -->
            <Style x:Key="NumberButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#333333" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="FontSize" Value="28" />
                <Setter Property="BorderWidth" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="4" />
            </Style>

            <!-- Styles pour les touches de fonction (AC, ±, %) -->
            <Style x:Key="FunctionButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#A5A5A5" />
                <Setter Property="TextColor" Value="Black" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="BorderWidth" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="4" />
            </Style>

            <!-- Styles pour les touches d'opérateurs (÷, ×, −, +, =) -->
            <Style x:Key="OperatorButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#FF9F0A" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="FontSize" Value="28" />
                <Setter Property="BorderWidth" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="4" />
            </Style>

            <!-- Style pour l'opérateur en attente (mise en évidence) -->
            <Style x:Key="OperatorActiveStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="TextColor" Value="#FF9F0A" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="FontSize" Value="28" />
                <Setter Property="BorderWidth" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="4" />
            </Style>

            <!-- Style pour le bouton retour -->
            <Style x:Key="BackspaceButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontSize" Value="24" />
                <Setter Property="Padding" Value="8,0" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <!-- Grid racine (1) : 2 lignes proportionnelles : affichage 2* / clavier 5* -->
    <Grid BackgroundColor="#000000" Padding="8" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*" />
            <RowDefinition Height="5*" />
        </Grid.RowDefinitions>

        <!-- Border (2) : Zone d'affichage avec fond transparent et padding -->
        <Border Grid.Row="0" Padding="16" BackgroundColor="Transparent">
            <!-- VerticalStackLayout (3) : Empile barre supérieure, opération et résultat -->
            <VerticalStackLayout Spacing="8" VerticalOptions="End">
                <!-- HorizontalStackLayout (4) : Barre supérieure avec bouton retour, alignée à droite -->
                <HorizontalStackLayout HorizontalOptions="End" Spacing="8">
                    <Button x:Name="BackspaceButton"
                            Style="{StaticResource BackspaceButtonStyle}"
                            Text="⌫"
                            WidthRequest="40"
                            HeightRequest="40"
                            Clicked="OnBackspaceClicked" />
                </HorizontalStackLayout>

                <!-- ScrollView (5) : Défilement horizontal de l'opération en cours -->
                <ScrollView Orientation="Horizontal" 
                           x:Name="OperationScrollView"
                           HorizontalScrollBarVisibility="Never">
                    <Label x:Name="OperationLabel"
                           Text=""
                           FontSize="18"
                           TextColor="#A5A5A5"
                           FontAttributes="None"
                           HorizontalTextAlignment="End"
                           VerticalTextAlignment="Center"
                           Margin="0,0,8,0" />
                </ScrollView>

                <!-- Label du résultat : texte blanc, gros, qui rétrécit avec AutoSize -->
                <Label x:Name="ResultLabel"
                       Text="0"
                       FontSize="56"
                       TextColor="White"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="End"
                       VerticalTextAlignment="Center"
                       LineBreakMode="NoWrap"
                       Margin="0,8,0,0" />
            </VerticalStackLayout>
        </Border>

        <!-- Grid du clavier (6) : 5 lignes × 4 colonnes avec tailles "*" (proportionnelles) -->
        <Grid Grid.Row="1" RowSpacing="4" ColumnSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Ligne 1 : AC, ±, %, ÷ -->
            <Button Grid.Row="0" Grid.Column="0"
                    Style="{StaticResource FunctionButtonStyle}"
                    Text="AC"
                    Clicked="OnClearClicked" />
            <Button Grid.Row="0" Grid.Column="1"
                    Style="{StaticResource FunctionButtonStyle}"
                    Text="±"
                    Clicked="OnToggleSignClicked" />
            <Button Grid.Row="0" Grid.Column="2"
                    Style="{StaticResource FunctionButtonStyle}"
                    Text="%"
                    Clicked="OnPercentClicked" />
            <Button Grid.Row="0" Grid.Column="3" x:Name="DivideButton"
                    Style="{StaticResource OperatorButtonStyle}"
                    Text="÷"
                    Clicked="OnOperatorClicked" />

            <!-- Ligne 2 : 7, 8, 9, × -->
            <Button Grid.Row="1" Grid.Column="0"
                    Style="{StaticResource NumberButtonStyle}"
                    Text="7"
                    Clicked="OnNumberClicked" />
            <Button Grid.Row="1" Grid.Column="1"
                    Style="{StaticResource NumberButtonStyle}"
                    Text="8"
                    Clicked="OnNumberClicked" />
            <Button Grid.Row="1" Grid.Column="2"
                    Style="{StaticResource NumberButtonStyle}"
                    Text="9"
                    Clicked="OnNumberClicked" />
            <Button Grid.Row="1" Grid.Column="3" x:Name="MultiplyButton"
                    Style="{StaticResource OperatorButtonStyle}"
                    Text="×"
                    Clicked="OnOperatorClicked" />

            <!-- Ligne 3 : 4, 5, 6, − -->
            <Button Grid.Row="2" Grid.Column="0"
                    Style="{StaticResource NumberButtonStyle}"
                    Text="4"
                    Clicked="OnNumberClicked" />
            <Button Grid.Row="2" Grid.Column="1"
                    Style="{StaticResource NumberButtonStyle}"
                    Text="5"
                    Clicked="OnNumberClicked" />
            <Button Grid.Row="2" Grid.Column="2"
                    Style="{StaticResource NumberButtonStyle}"
                    Text="6"
                    Clicked="OnNumberClicked" />
            <Button Grid.Row="2" Grid.Column="3" x:Name="SubtractButton"
                    Style="{StaticResource OperatorButtonStyle}"
                    Text="−"
                    Clicked="OnOperatorClicked" />

            <!-- Ligne 4 : 1, 2, 3, + -->
            <Button Grid.Row="3" Grid.Column="0"
                    Style="{StaticResource NumberButtonStyle}"
                    Text="1"
                    Clicked="OnNumberClicked" />
            <Button Grid.Row="3" Grid.Column="1"
                    Style="{StaticResource NumberButtonStyle}"
                    Text="2"
                    Clicked="OnNumberClicked" />
            <Button Grid.Row="3" Grid.Column="2"
                    Style="{StaticResource NumberButtonStyle}"
                    Text="3"
                    Clicked="OnNumberClicked" />
            <Button Grid.Row="3" Grid.Column="3" x:Name="AddButton"
                    Style="{StaticResource OperatorButtonStyle}"
                    Text="+"
                    Clicked="OnOperatorClicked" />

            <!-- Ligne 5 : 0 (2 colonnes), ., = -->
            <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                    Style="{StaticResource NumberButtonStyle}"
                    Text="0"
                    Clicked="OnNumberClicked" />
            <Button Grid.Row="4" Grid.Column="2"
                    Style="{StaticResource NumberButtonStyle}"
                    Text="."
                    Clicked="OnDecimalClicked" />
            <Button Grid.Row="4" Grid.Column="3" x:Name="EqualsButton"
                    Style="{StaticResource OperatorButtonStyle}"
                    Text="="
                    Clicked="OnEqualsClicked" />
        </Grid>
    </Grid>
</ContentPage>
